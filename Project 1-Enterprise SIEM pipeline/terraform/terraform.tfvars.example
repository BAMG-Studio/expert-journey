# =============================================================================
# Example Terraform Variables - Copy to terraform.tfvars and customize
# =============================================================================

project_name = "siem-pipeline"
environment  = "dev"
aws_region   = "us-east-1"

# VPC
vpc_cidr        = "10.0.0.0/16"
private_subnets = ["10.0.1.0/24", "10.0.2.0/24"]
availability_zones = ["us-east-1a", "us-east-1b"]

# S3
s3_retention_days        = 365
glacier_transition_days  = 90

# CloudTrail
enable_org_trail          = false
cloudwatch_retention_days = 90

# OpenSearch
opensearch_version        = "OpenSearch_2.11"
opensearch_instance_type  = "t3.medium.search"
opensearch_instance_count = 2
opensearch_ebs_size       = 100
opensearch_master_user    = "admin"
opensearch_master_password = "CHANGE_ME_SecurePassword123!"

# Lambda
lambda_log_level = "INFO"
